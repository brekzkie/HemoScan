# ================================================================
# .env.example — Template Konfigurasi Environment HemoScan
# ================================================================
#
# CARA PAKAI:
#   1. Salin file ini menjadi .env
#        Windows  : copy .env.example .env
#        Mac/Linux: cp .env.example .env
#
#   2. Isi nilai POSTGRES_PASSWORD sesuai password PostgreSQL Anda
#
#   3. Jalankan server:
#        python server.py
#
# CATATAN:
#   - File .env berisi kredensial sensitif, JANGAN di-commit ke Git!
#   - File ini (.env.example) AMAN untuk dibagikan karena tidak
#     berisi password asli.
#   - Jika menggunakan Docker Compose, konfigurasi database sudah
#     diatur di docker-compose.yml (file .env tidak diperlukan).
#
# ================================================================

# ── PostgreSQL Database ───────────────────────────────────────────
# Konfigurasi koneksi ke database PostgreSQL lokal.
# Pastikan PostgreSQL sudah terinstall dan berjalan di komputer Anda.

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=hemoscan
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# ── Opsional: Connection URL ─────────────────────────────────────
# Jika diisi, akan menggantikan parameter individual di atas.
# Format: postgresql://user:password@host:port/database
#
# POSTGRES_URL=postgresql://postgres:your_password_here@127.0.0.1:5432/hemoscan


# ── Default Admin Kredensial ──────────────────────────────────────
# Digunakan oleh script database/init_db.py untuk seeding akun admin default.
# Ubah password ini saat deploy di production / publik!
ADMIN_EMAIL=admin@hemoscan.com
ADMIN_PASSWORD=admin123
ADMIN_DISPLAY_NAME=Administrator
