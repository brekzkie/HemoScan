    "\n",
    "axes[0,2].plot(ep_lr, lrs, color='purple', lw=2)\n",
    "axes[0,2].set_title('LR Schedule'); axes[0,2].set_yscale('log'); axes[0,2].grid(alpha=0.3)\n",
    "\n",
