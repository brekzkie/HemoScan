    "# ================================================================\n",
    "# CELL 3 — SCAN FOLDER (tidak berubah)\n",
    "# ================================================================\n",
    "\n",
    "def scan_folder_by_number(country_folder, keyword=IMAGE_KEYWORD):\n",
    "    number_to_path = {}\n",
    "    missing_keyword = []\n",
    "\n",
    "    if not os.path.exists(country_folder):\n",
    "        print(f'  ⚠️  Folder tidak ada: {country_folder}')\n",
    "        return number_to_path\n",
    "\n",
    "    for item in sorted(os.listdir(country_folder)):\n",
    "        subfolder = os.path.join(country_folder, item)\n",
    "        if not os.path.isdir(subfolder):\n",
    "            continue\n",
    "        try:\n",
    "            number = int(item)\n",
    "        except ValueError:\n",
    "            continue\n",
    "\n",
    "        found    = None\n",
    "        all_imgs = []\n",
    "\n",
    "        for fname in sorted(os.listdir(subfolder)):\n",
    "            ext = os.path.splitext(fname)[1].lower()\n",
    "            if ext not in ('.jpg', '.jpeg', '.png', '.bmp', '.tiff'):\n",
    "                continue\n",
    "            all_imgs.append(fname)\n",
    "            if keyword == '':\n",
    "                found = os.path.join(subfolder, fname)\n",
    "                break\n",
    "            if keyword.lower() in fname.lower():\n",
    "                found = os.path.join(subfolder, fname)\n",
    "                break\n",
    "\n",
    "        if found:\n",
    "            number_to_path[number] = found\n",
    "        else:\n",
    "            missing_keyword.append((number, all_imgs))\n",
    "\n",
    "    print(f'  Subfolder ditemukan: {len(number_to_path)} gambar valid')\n",
    "    if missing_keyword[:5]:\n",
    "        print(f'  ⚠️  {len(missing_keyword)} subfolder tanpa keyword \"{keyword}\":')\n",
    "        for num, imgs in missing_keyword[:3]:\n",
    "            print(f'     Number={num}: {imgs[:3]}')\n",
    "        if len(missing_keyword) > 3:\n",
    "            print(f'     ... dan {len(missing_keyword)-3} lainnya')\n",
    "\n",
    "    return number_to_path\n",
    "\n",
    "\n",
    "print('Scan folder India...')\n",
    "map_india = scan_folder_by_number(FOLDER_INDIA, keyword=IMAGE_KEYWORD)\n",
    "print('Scan folder Italy...')\n",
    "map_italy = scan_folder_by_number(FOLDER_ITALY, keyword=IMAGE_KEYWORD)\n",
    "\n",
    "if len(map_india) == 0:\n",
    "    print('\\n⚠️  Fallback: ambil semua gambar India...')\n",
    "    map_india = scan_folder_by_number(FOLDER_INDIA, keyword='')\n",
    "if len(map_italy) == 0:\n",
    "    print('\\n⚠️  Fallback: ambil semua gambar Italy...')\n",
    "    map_italy = scan_folder_by_number(FOLDER_ITALY, keyword='')\n",
    "\n",
    "print(f'\\nTotal peta gambar: India={len(map_india)}, Italy={len(map_italy)}')\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# CELL 4 — LOAD EXCEL + LABELING OTOMATIS (tidak berubah)\n",
    "# ================================================================\n",
    "\n",
    "def load_and_label_excel(file_path, number_to_path_map, country_name):\n",
    "    df = pd.read_excel(file_path)\n",
    "    junk = [c for c in df.columns if 'unnamed' in c.lower() or c.lower() in ('note', 'notes')]\n",
    "    df   = df.drop(columns=junk, errors='ignore')\n",
    "    print(f'\\n[{country_name}] Kolom: {list(df.columns)}')\n",
    "\n",
    "    col_map = {c.strip().lower(): c.strip() for c in df.columns}\n",
    "\n",
    "    num_col = None\n",
    "    for candidate in ('number', 'no', 'no.', 'id', 'sample', 'num'):\n",
    "        if candidate in col_map:\n",
    "            num_col = col_map[candidate]; break\n",
    "    if num_col is None:\n",
    "        raise ValueError(f\"Kolom 'Number' tidak ditemukan di {country_name}.\")\n",
    "\n",
    "    hgb_col = None\n",
    "    for candidate in ('hgb', 'hemoglobin', 'hb', 'haemoglobin'):\n",
    "        if candidate in col_map:\n",
    "            hgb_col = col_map[candidate]; break\n",
    "    if hgb_col is None:\n",
    "        raise ValueError(f\"Kolom 'Hgb' tidak ditemukan di {country_name}.\")\n",
    "\n",
    "    df['Hgb_clean'] = pd.to_numeric(\n",
    "        df[hgb_col].astype(str).str.replace(',', '.', regex=False).str.strip(),\n",
    "        errors='coerce'\n",
    "    )\n",
    "\n",
    "    gender_col = None\n",
    "    for candidate in ('gender', 'sex', 'jenis kelamin'):\n",
    "        if candidate in col_map:\n",
    "            gender_col = col_map[candidate]; break\n",
    "    df['Gender_clean'] = df[gender_col].astype(str).str.strip() if gender_col else 'Unknown'\n",
    "\n",
    "    df = df.dropna(subset=['Hgb_clean']).copy()\n",
    "    df[num_col] = pd.to_numeric(df[num_col], errors='coerce')\n",
    "    df = df.dropna(subset=[num_col]).copy()\n",
    "    df[num_col] = df[num_col].astype(int)\n",
    "\n",
    "    def assign_label(row):\n",
    "        hgb = row['Hgb_clean']\n",
    "        g   = row['Gender_clean'].upper()\n",
    "        if g in ('F', 'FEMALE', 'PEREMPUAN', 'P', 'W', 'WANITA'):\n",
    "            return 'Anemia' if hgb < HGB_THRESHOLD_FEMALE else 'Non-Anemia'\n",
    "        elif g in ('M', 'MALE', 'LAKI', 'LAKI-LAKI', 'L', 'PRIA', 'MAN'):\n",
    "            return 'Anemia' if hgb < HGB_THRESHOLD_MALE else 'Non-Anemia'\n",
    "        else:\n",
    "            return 'Anemia' if hgb < HGB_THRESHOLD_SINGLE else 'Non-Anemia'\n",
    "\n",
    "    df['label']     = df.apply(assign_label, axis=1)\n",
    "    df['y']         = (df['label'] == 'Anemia').astype(int)\n",
    "    df['full_path'] = df[num_col].map(number_to_path_map)\n",
    "\n",
    "    total   = len(df)\n",
    "    matched = df['full_path'].notna().sum()\n",
    "    print(f'  Total sampel      : {total}')\n",
    "    print(f'  Gambar ditemukan  : {matched}')\n",
    "    print(f'  Anemia            : {(df[\"y\"]==1).sum()} ({(df[\"y\"]==1).mean()*100:.1f}%)')\n",
    "    print(f'  Non-Anemia        : {(df[\"y\"]==0).sum()} ({(df[\"y\"]==0).mean()*100:.1f}%)')\n",
    "    print(f'  HGB range         : {df[\"Hgb_clean\"].min():.1f} – {df[\"Hgb_clean\"].max():.1f}')\n",
    "\n",
    "    return df[['full_path', 'Hgb_clean', 'Gender_clean', 'label', 'y']].copy()\n",
    "\n",
    "\n",
    "dfs = []\n",
    "if os.path.exists(FILE_INDIA) and len(map_india) > 0:\n",
    "    dfs.append(load_and_label_excel(FILE_INDIA, map_india, 'India'))\n",
    "if os.path.exists(FILE_ITALY) and len(map_italy) > 0:\n",
    "    dfs.append(load_and_label_excel(FILE_ITALY, map_italy, 'Italy'))\n",
    "if not dfs:\n",
    "    raise RuntimeError(\"Tidak ada data yang berhasil dimuat.\")\n",
    "\n",
    "df_all   = pd.concat(dfs, ignore_index=True)\n",
    "df_valid = df_all.dropna(subset=['full_path']).reset_index(drop=True)\n",
    "\n",
    "print(f'\\nTotal valid (ada gambar + label): {len(df_valid)}')\n",
    "print(f'Distribusi: {df_valid[\"label\"].value_counts().to_dict()}')\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# CELL 5 — SPLIT DATA (tidak berubah)\n",
    "# ================================================================\n",
    "\n",
    "le = LabelEncoder()\n",
    "df_valid['y_enc'] = le.fit_transform(df_valid['label'])\n",
    "ANEM_IDX = int(np.where(le.classes_ == 'Anemia')[0][0])\n",
    "print(f'Kelas: {list(le.classes_)} | Anemia index: {ANEM_IDX}')\n",
    "\n",
    "train_val, test_df = train_test_split(\n",
    "    df_valid, test_size=TEST_RATIO,\n",
    "    random_state=RANDOM_SEED, stratify=df_valid['y_enc']\n",
    ")\n",
    "val_ratio_rel = VAL_RATIO / (TRAIN_RATIO + VAL_RATIO)\n",
    "train_df, val_df = train_test_split(\n",
    "    train_val, test_size=val_ratio_rel,\n",
    "    random_state=RANDOM_SEED, stratify=train_val['y_enc']\n",
    ")\n",
    "\n",
    "train_df = train_df.reset_index(drop=True)\n",
    "val_df   = val_df.reset_index(drop=True)\n",
    "test_df  = test_df.reset_index(drop=True)\n",
    "\n",
    "print(f'\\nTrain : {len(train_df)} | Val: {len(val_df)} | Test: {len(test_df)}')\n",
    "print(f'Distribusi train:')\n",
    "print(train_df['label'].value_counts())\n",
    "\n",
    "n_total      = len(train_df)\n",
    "n_0          = (train_df['y_enc'] == 0).sum()\n",
    "n_1          = (train_df['y_enc'] == 1).sum()\n",
    "CLASS_WEIGHTS = {0: n_total / (2 * n_0), 1: n_total / (2 * n_1)}\n",
    "print(f'\\nClass weights: {CLASS_WEIGHTS}')\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# CELL 6 — AUGMENTASI\n",
    "# ================================================================\n",
    "\n",
    "aug_train = A.Compose([\n",
    "    A.HorizontalFlip(p=0.5),\n",
    "    A.ShiftScaleRotate(shift_limit=0.05, scale_limit=0.08, rotate_limit=10,\n",
    "                       border_mode=cv2.BORDER_REFLECT_101, p=0.6),\n",
    "    A.RandomBrightnessContrast(brightness_limit=0.20, contrast_limit=0.20, p=0.7),\n",
    "    A.HueSaturationValue(hue_shift_limit=8, sat_shift_limit=20, val_shift_limit=10, p=0.6),\n",
    "    A.CLAHE(clip_limit=2.0, tile_grid_size=(8, 8), p=0.4),\n",
    "    A.GaussNoise(var_limit=(5.0, 20.0), p=0.25),\n",
    "    A.Resize(IMG_SIZE, IMG_SIZE),\n",
    "])\n",
    "\n",
    "# ✨ Augmentasi lebih agresif khusus untuk generate gambar sintetis\n",
    "aug_synth = A.Compose([\n",
    "    A.HorizontalFlip(p=0.5),\n",
    "    A.VerticalFlip(p=0.3),\n",
    "    A.ShiftScaleRotate(shift_limit=0.10, scale_limit=0.15, rotate_limit=20,\n",
    "                       border_mode=cv2.BORDER_REFLECT_101, p=0.8),\n",
    "    A.RandomBrightnessContrast(brightness_limit=0.30, contrast_limit=0.30, p=0.8),\n",
    "    A.HueSaturationValue(hue_shift_limit=15, sat_shift_limit=30, val_shift_limit=15, p=0.7),\n",
    "    A.CLAHE(clip_limit=3.0, tile_grid_size=(8, 8), p=0.5),\n",
    "    A.GaussNoise(var_limit=(10.0, 40.0), p=0.4),\n",
    "    A.ElasticTransform(alpha=1, sigma=10, p=0.3),\n",
    "    A.GridDistortion(num_steps=5, distort_limit=0.2, p=0.3),\n",
    "    A.CoarseDropout(max_holes=4, max_height=20, max_width=20,\n",
    "                    min_holes=1, fill_value=0, p=0.3),\n",
    "    A.Resize(IMG_SIZE, IMG_SIZE),\n",
    "])\n",
    "\n",
    "aug_tta = A.Compose([\n",
    "    A.HorizontalFlip(p=0.5),\n",
    "    A.ShiftScaleRotate(shift_limit=0.03, scale_limit=0.05, rotate_limit=5,\n",
    "                       border_mode=cv2.BORDER_REFLECT_101, p=0.5),\n",
    "    A.RandomBrightnessContrast(brightness_limit=0.10, contrast_limit=0.10, p=0.5),\n",
    "    A.Resize(IMG_SIZE, IMG_SIZE),\n",
    "])\n",
    "\n",
    "aug_eval = A.Compose([\n",
    "    A.LongestMaxSize(max_size=IMG_SIZE),\n",
    "    A.PadIfNeeded(min_height=IMG_SIZE, min_width=IMG_SIZE,\n",
    "                  border_mode=cv2.BORDER_CONSTANT, value=0),\n",
    "    A.Resize(IMG_SIZE, IMG_SIZE),\n",
    "])\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# CELL 7 — ✨ OFFLINE DATA GENERATION (simpan ke disk)\n",
    "# ================================================================\n",
    "# Strategi: ambil gambar kelas minoritas, augmentasi N× dan simpan.\n",
    "# Gambar baru ini ditambahkan ke train_df sebelum training.\n",
    "# Hasilnya: lebih banyak data nyata + variasi, bukan hanya loop.\n",
    "\n",
    "def generate_synthetic_images(df_train, synth_dir, multiplier=3, label_enc=None):\n",
    "    \"\"\"\n",
    "    Generate gambar sintetis dari kelas minoritas dengan augmentasi agresif.\n",
    "    \n",
    "    Args:\n",
    "        df_train   : DataFrame training\n",
    "        synth_dir  : folder untuk menyimpan gambar hasil generate\n",
    "        multiplier : jumlah gambar baru per gambar asli\n",
    "        label_enc  : LabelEncoder untuk decode label\n",
    "    \n",
    "    Returns:\n",
    "        df_synth : DataFrame berisi path + label gambar sintetis baru\n",
    "    \"\"\"\n",
    "    # Identifikasi kelas minoritas\n",
    "    counts   = df_train['y_enc'].value_counts()\n",
    "    min_cls  = counts.idxmin()   # kelas dengan sampel lebih sedikit\n",
    "    maj_cls  = counts.idxmax()\n",
    "    min_name = label_enc.classes_[min_cls]\n",
    "    maj_name = label_enc.classes_[maj_cls]\n",
    "\n",
    "    print(f'\\n[Offline Generation]')\n",
    "    print(f'  Mayoritas : {maj_name} ({counts[maj_cls]} sampel)')\n",
    "    print(f'  Minoritas : {min_name} ({counts[min_cls]} sampel)')\n",
    "    print(f'  Target    : {multiplier}× augmentasi per gambar minoritas')\n",
    "\n",
    "    df_minority = df_train[df_train['y_enc'] == min_cls].reset_index(drop=True)\n",
    "    synth_rows  = []\n",
    "    n_generated = 0\n",
    "\n",
    "    for _, row in df_minority.iterrows():\n",
    "        img_bgr = cv2.imread(row['full_path'])\n",
    "        if img_bgr is None:\n",
    "            continue\n",
    "        img_rgb = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB)\n",
    "\n",
    "        for i in range(multiplier):\n",
    "            aug_img  = aug_synth(image=img_rgb)['image']\n",
    "            fname    = f'synth_{min_name}_{n_generated:05d}.jpg'\n",
    "            out_path = os.path.join(synth_dir, fname)\n",
    "            cv2.imwrite(out_path, cv2.cvtColor(aug_img, cv2.COLOR_RGB2BGR),\n",
    "                        [cv2.IMWRITE_JPEG_QUALITY, 95])\n",
    "\n",
    "            synth_rows.append({\n",
    "                'full_path'    : out_path,\n",
    "                'Hgb_clean'   : row['Hgb_clean'],\n",
    "                'Gender_clean': row['Gender_clean'],\n",
    "                'label'        : row['label'],\n",
    "                'y'            : row['y'],\n",
    "                'y_enc'        : row['y_enc'],\n",
    "            })\n",
    "            n_generated += 1\n",
    "\n",
    "    df_synth = pd.DataFrame(synth_rows)\n",
    "    print(f'  ✅ {n_generated} gambar sintetis disimpan ke: {synth_dir}')\n",
    "    return df_synth\n",
    "\n",
    "\n",
    "# ✨ Jalankan offline generation pada train set saja\n",
    "if USE_OFFLINE_SYNTH:\n",
    "    df_synth = generate_synthetic_images(\n",
    "        train_df, SYNTH_DIR,\n",
    "        multiplier=SYNTH_MULTIPLIER,\n",
    "        label_enc=le\n",
    "    )\n",
    "    # Gabungkan ke train_df\n",
    "    train_df_aug = pd.concat([train_df, df_synth], ignore_index=True).sample(\n",
    "        frac=1, random_state=RANDOM_SEED  # shuffle setelah gabung\n",
    "    ).reset_index(drop=True)\n",
    "\n",
    "    print(f'\\nDistribusi train SETELAH generation:')\n",
    "    print(train_df_aug['label'].value_counts())\n",
    "else:\n",
    "    train_df_aug = train_df.copy()\n",
    "    print('\\nOffline generation dilewati.')\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# CELL 8 — ✨ SMOTE-LIKE IMAGE INTERPOLATION (opsional tambahan)\n",
    "# ================================================================\n",
    "# Mirip SMOTE tapi untuk gambar: interpolasi dua gambar kelas sama.\n",
    "# Menghasilkan gambar \"di antara\" dua sampel → lebih beragam dari augmentasi biasa.\n",
    "\n",
    "def image_smote(df_train, synth_dir, n_samples=50, label_enc=None):\n",
    "    \"\"\"\n",
    "    Buat gambar sintetis dengan interpolasi dua gambar dari kelas minoritas.\n",
    "    Mirip SMOTE untuk data tabular, tapi di pixel space.\n",
    "    \n",
    "    Args:\n",
    "        n_samples : jumlah gambar interpolasi yang dibuat\n",
    "    \"\"\"\n",
    "    counts   = df_train['y_enc'].value_counts()\n",
    "    min_cls  = counts.idxmin()\n",
    "    min_name = label_enc.classes_[min_cls]\n",
    "\n",
    "    df_min = df_train[df_train['y_enc'] == min_cls].reset_index(drop=True)\n",
    "\n",
    "    if len(df_min) < 2:\n",
    "        print('  ⚠️  Kelas minoritas < 2 sampel, SMOTE dilewati.')\n",
    "        return pd.DataFrame()\n",
    "\n",
    "    print(f'\\n[Image SMOTE] Membuat {n_samples} gambar interpolasi untuk kelas {min_name}...')\n",
    "    smote_rows = []\n",
    "\n",
    "    for i in range(n_samples):\n",
    "        # Pilih 2 gambar acak dari kelas minoritas\n",
    "        idx_a, idx_b = np.random.choice(len(df_min), 2, replace=False)\n",
    "        row_a = df_min.iloc[idx_a]\n",
    "        row_b = df_min.iloc[idx_b]\n",
    "\n",
    "        img_a = cv2.imread(row_a['full_path'])\n",
    "        img_b = cv2.imread(row_b['full_path'])\n",
    "        if img_a is None or img_b is None:\n",
    "            continue\n",
    "\n",
    "        img_a = cv2.resize(img_a, (IMG_SIZE, IMG_SIZE))\n",
    "        img_b = cv2.resize(img_b, (IMG_SIZE, IMG_SIZE))\n",
    "\n",
    "        # Interpolasi dengan lambda acak antara 0.3–0.7\n",
    "        lam     = np.random.uniform(0.3, 0.7)\n",
    "        img_mix = (lam * img_a.astype(np.float32) +\n",
    "                   (1 - lam) * img_b.astype(np.float32)).astype(np.uint8)\n",
    "\n",
    "        fname    = f'smote_{min_name}_{i:05d}.jpg'\n",
    "        out_path = os.path.join(synth_dir, fname)\n",
    "        cv2.imwrite(out_path, img_mix, [cv2.IMWRITE_JPEG_QUALITY, 95])\n",
    "\n",
    "        smote_rows.append({\n",
    "            'full_path'    : out_path,\n",
    "            'Hgb_clean'   : row_a['Hgb_clean'],\n",
    "            'Gender_clean': row_a['Gender_clean'],\n",
    "            'label'        : row_a['label'],\n",
    "            'y'            : row_a['y'],\n",
    "            'y_enc'        : row_a['y_enc'],\n",
    "        })\n",
    "\n",
    "    df_smote = pd.DataFrame(smote_rows)\n",
    "    print(f'  ✅ {len(df_smote)} gambar SMOTE disimpan')\n",
    "    return df_smote\n",
    "\n",
    "\n",
    "# Hitung jumlah SMOTE yang dibutuhkan untuk menyamakan kelas\n",
    "counts_aug = train_df_aug['y_enc'].value_counts()\n",
    "n_smote    = abs(int(counts_aug.max() - counts_aug.min()))\n",
    "n_smote    = min(n_smote, 200)  # batasi maksimal 200 agar tidak berlebihan\n",
    "\n",
    "if USE_OFFLINE_SYNTH and n_smote > 0:\n",
    "    df_smote = image_smote(train_df_aug, SYNTH_DIR,\n",
    "                           n_samples=n_smote, label_enc=le)\n",
    "    if len(df_smote) > 0:\n",
    "        train_df_aug = pd.concat([train_df_aug, df_smote], ignore_index=True).sample(\n",
    "            frac=1, random_state=RANDOM_SEED\n",
    "        ).reset_index(drop=True)\n",
    "\n",
    "print(f'\\nFinal train size: {len(train_df_aug)}')\n",
    "print(f'Final distribusi:')\n",
    "print(train_df_aug['label'].value_counts())\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# CELL 9 — DATA GENERATOR (original + ✨ BalancedGenerator)\n",
    "# ================================================================\n",
    "\n",
    "def load_image(full_path, aug_pipeline):\n",
    "    img_bgr = cv2.imread(full_path)\n",
    "    if img_bgr is None:\n",
    "        return np.zeros((IMG_SIZE, IMG_SIZE, 3), dtype=np.float32)\n",
    "    img_rgb = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB)\n",
    "    aug_out = aug_pipeline(image=img_rgb)['image']\n",
    "    return preprocess_input(aug_out.astype(np.float32))\n",
    "\n",
    "\n",
    "def mixup_batch(X, y, alpha=0.2):\n",
    "    bs  = X.shape[0]\n",
    "    lam = np.random.beta(alpha, alpha, bs)\n",
    "    idx = np.random.permutation(bs)\n",
    "    lx  = lam.reshape(bs, 1, 1, 1).astype(np.float32)\n",
    "    ly  = lam.reshape(bs, 1).astype(np.float32)\n",
    "    return (lx * X + (1 - lx) * X[idx],\n",
    "            (ly * y.reshape(-1, 1) + (1 - ly) * y[idx].reshape(-1, 1)).flatten())\n",
    "\n",
    "\n",
    "# ── Generator original (untuk val/test) ──────────────────────\n",
    "class AnemiaGenerator(keras.utils.Sequence):\n",
    "    def __init__(self, df, aug_pipeline, batch_size,\n",
    "                 shuffle=True, use_mixup=True, mixup_alpha=0.2):\n",
    "        self.df          = df.reset_index(drop=True)\n",
    "        self.aug         = aug_pipeline\n",
    "        self.batch_size  = batch_size\n",
    "        self.shuffle     = shuffle\n",
    "        self.use_mixup   = use_mixup\n",
    "        self.mixup_alpha = mixup_alpha\n",
    "        self.indices     = np.arange(len(self.df))\n",
    "        self.on_epoch_end()\n",
    "\n",
    "    def __len__(self):\n",
    "        return math.ceil(len(self.df) / self.batch_size)\n",
    "\n",
    "    def on_epoch_end(self):\n",
    "        if self.shuffle:\n",
    "            np.random.shuffle(self.indices)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        batch_idx  = self.indices[idx * self.batch_size:(idx + 1) * self.batch_size]\n",
    "        batch_rows = self.df.iloc[batch_idx]\n",
    "        X = np.array([load_image(r['full_path'], self.aug)\n",
    "                      for _, r in batch_rows.iterrows()], dtype=np.float32)\n",
    "        y = batch_rows['y_enc'].values.astype(np.float32)\n",
    "        if self.use_mixup and len(X) > 1:\n",
    "            X, y = mixup_batch(X, y, alpha=self.mixup_alpha)\n",
    "        return X, y\n",
    "\n",
    "\n",
    "# ✨ ── BalancedGenerator: online oversampling per batch ───────\n",
    "class BalancedAnemiaGenerator(keras.utils.Sequence):\n",
    "    \"\"\"\n",
    "    Generator dengan online oversampling.\n",
    "    \n",
    "    Setiap batch berisi 50% kelas 0 dan 50% kelas 1,\n",
    "    dengan mengulang (oversample) kelas minoritas secara acak.\n",
    "    \n",
    "    Keunggulan vs class_weight:\n",
    "    - Model melihat jumlah sample yang benar-benar seimbang per batch\n",
    "    - Tidak hanya mengubah loss weight, tapi benar-benar melatih lebih banyak\n",
    "      pada kelas minoritas\n",
    "    \"\"\"\n",
    "    def __init__(self, df, aug_pipeline, batch_size,\n",
    "                 use_mixup=True, mixup_alpha=0.2):\n",
    "        self.df          = df.reset_index(drop=True)\n",
    "        self.aug         = aug_pipeline\n",
    "        self.batch_size  = batch_size\n",
    "        self.use_mixup   = use_mixup\n",
    "        self.mixup_alpha = mixup_alpha\n",
    "\n",
    "        # Pisahkan indeks per kelas\n",
    "        self.idx_cls = {}\n",
    "        for cls in self.df['y_enc'].unique():\n",
    "            self.idx_cls[cls] = self.df[self.df['y_enc'] == cls].index.tolist()\n",
    "\n",
    "        self.n_cls    = len(self.idx_cls)\n",
    "        self.half_bs  = batch_size // self.n_cls  # sampel per kelas per batch\n",
    "        self._shuffle_all()\n",
    "\n",
    "    def _shuffle_all(self):\n",
    "        \"\"\"Shuffle indeks tiap kelas dan buat queue untuk epoch ini.\"\"\"\n",
    "        self.queues = {}\n",
    "        for cls, idxs in self.idx_cls.items():\n",
    "            shuffled = idxs.copy()\n",
    "            np.random.shuffle(shuffled)\n",
    "            # Ulangi queue agar cukup untuk satu epoch\n",
    "            n_needed = self.half_bs * len(self)\n",
    "            repeats  = math.ceil(n_needed / len(shuffled))\n",
    "            self.queues[cls] = (shuffled * repeats)[:n_needed]\n",
    "\n",
    "    def __len__(self):\n",
    "        # Panjang epoch = total unik sampel mayoritas / batch_size\n",
    "        n_maj = max(len(v) for v in self.idx_cls.values())\n",
    "        return math.ceil(n_maj / self.half_bs)\n",
    "\n",
    "    def on_epoch_end(self):\n",
    "        self._shuffle_all()\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        rows = []\n",
    "        for cls in sorted(self.idx_cls.keys()):\n",
    "            start    = idx * self.half_bs\n",
    "            end      = start + self.half_bs\n",
    "            sel_idxs = self.queues[cls][start:end]\n",
    "            rows.append(self.df.iloc[sel_idxs])\n",
    "\n",
    "        batch_rows = pd.concat(rows).sample(frac=1)  # shuffle dalam batch\n",
    "        X = np.array([load_image(r['full_path'], self.aug)\n",
    "                      for _, r in batch_rows.iterrows()], dtype=np.float32)\n",
    "        y = batch_rows['y_enc'].values.astype(np.float32)\n",
    "\n",
    "        if self.use_mixup and len(X) > 1:\n",
    "            X, y = mixup_batch(X, y, alpha=self.mixup_alpha)\n",
    "        return X, y\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# CELL 10 — MODEL (tidak berubah)\n",
    "# ================================================================\n",
    "\n",
    "class GeMPooling(layers.Layer):\n",
    "    def __init__(self, p=3.0, **kwargs):\n",
    "        super().__init__(**kwargs)\n",
    "        self.p = tf.Variable(p, trainable=True, dtype=tf.float32, name='gem_p')\n",
    "\n",
    "    def call(self, x, training=None):\n",
    "        x = tf.clip_by_value(x, 1e-6, tf.reduce_max(x))\n",
    "        return tf.pow(tf.reduce_mean(tf.pow(x, self.p), axis=[1, 2]), 1.0 / self.p)\n",
    "\n",
    "    def get_config(self):\n",
    "        config = super().get_config()\n",
    "        config.update({'p': float(self.p.numpy())})\n",
    "        return config\n",
    "\n",
    "\n",
    "def build_model(input_shape=(IMG_SIZE, IMG_SIZE, 3), l2_reg=1e-4):\n",
    "    backbone = EfficientNetB0(weights='imagenet', include_top=False,\n",
    "                               input_shape=input_shape, pooling=None)\n",
    "    backbone.trainable = False\n",
    "    print(f'Backbone FROZEN: {backbone.count_params():,} params')\n",
    "\n",
    "    inputs = keras.Input(shape=input_shape, name='input')\n",
    "    x      = backbone(inputs, training=False)\n",
    "    x      = GeMPooling(p=3.0, name='gem_pool')(x)\n",
    "    x      = layers.LayerNormalization(name='feat_norm')(x)\n",
    "\n",
    "    for units, drop, name in [(512, 0.5, '512'), (256, 0.4, '256'), (128, 0.3, '128')]:\n",
    "        x = layers.Dense(units, kernel_regularizer=regularizers.l2(l2_reg),\n",
    "                         name=f'dense_{name}')(x)\n",
    "        x = layers.BatchNormalization(name=f'bn_{name}')(x)\n",
    "        x = layers.Activation('relu', name=f'relu_{name}')(x)\n",
    "        x = layers.Dropout(drop, name=f'do_{name}')(x)\n",
    "\n",
    "    outputs = layers.Dense(1, activation='sigmoid', name='output')(x)\n",
    "    model   = keras.Model(inputs=inputs, outputs=outputs, name='AnemiaNet')\n",
    "    model.compile(\n",
    "        optimizer=optimizers.AdamW(learning_rate=LR_INITIAL, weight_decay=1e-4),\n",
    "        loss=keras.losses.BinaryCrossentropy(label_smoothing=0.1),\n",
    "        metrics=['accuracy', keras.metrics.AUC(name='auc'),\n",
    "                 keras.metrics.Precision(name='precision'),\n",
    "                 keras.metrics.Recall(name='recall')]\n",
    "    )\n",
    "    head_p = sum(tf.size(w).numpy() for w in model.trainable_weights)\n",
    "    print(f'Head (trainable): {head_p:,} params')\n",
    "    return model\n",
    "\n",
    "\n",
    "def cosine_warmup_lr(epoch, total=TOTAL_EPOCHS, lr_max=LR_INITIAL,\n",
    "                     lr_min=LR_MIN, warmup=5):\n",
    "    if epoch < warmup:\n",
    "        return lr_min + (lr_max - lr_min) * (epoch / warmup)\n",
    "    progress = (epoch - warmup) / (total - warmup)\n",
    "    return lr_min + 0.5 * (lr_max - lr_min) * (1 + math.cos(math.pi * progress))\n",
    "\n",
    "\n",
    "def get_callbacks(output_dir):\n",
    "    return [\n",
    "        callbacks.ModelCheckpoint(\n",
    "            os.path.join(output_dir, 'best_model.keras'),\n",
    "            monitor='val_auc', mode='max', save_best_only=True, verbose=1),\n",
    "        callbacks.EarlyStopping(\n",
    "            monitor='val_auc', mode='max', patience=20,\n",
    "            restore_best_weights=True, min_delta=0.005, verbose=1),\n",
    "        callbacks.LearningRateScheduler(cosine_warmup_lr, verbose=0),\n",
    "        callbacks.CSVLogger(os.path.join(output_dir, 'log.csv')),\n",
    "    ]\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# CELL 11 — TRAINING (✨ pakai BalancedGenerator + train_df_aug)\n",
    "# ================================================================\n",
    "\n",
