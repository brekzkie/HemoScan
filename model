{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.12","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"datasetVersion","sourceId":8113675,"datasetId":4793279,"databundleVersionId":8232324}],"dockerImageVersionId":31329,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":true}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# ================================================================\n#  DETEKSI ANEMIA — V2 (FIXED: subfolder bernomor)\n#  EfficientNetB0 | Label otomatis dari HGB (< 12 = Anemia)\n#\n#  PERBAIKAN dari V1:\n#    - Struktur folder: India/{1,2,3,...}/ bukan folder flat\n#    - Scan rekursif ke subfolder bernomor\n#    - Cari file gambar palpebral di dalam tiap subfolder\n#    - Map Number (dari Excel) → path gambar yang benar\n# ================================================================\n\n# !pip install albumentations openpyxl --quiet\n\n\n# ================================================================\n# CELL 1 — IMPORTS\n# ================================================================\n\nimport os, math, time, warnings, joblib\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport cv2\nimport albumentations as A\nimport tensorflow as tf\nfrom tensorflow import keras\nfrom tensorflow.keras import layers, callbacks, optimizers, regularizers\nfrom tensorflow.keras.applications import EfficientNetB0\nfrom tensorflow.keras.applications.efficientnet import preprocess_input\nfrom sklearn.preprocessing import LabelEncoder\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import (\n    classification_report, roc_auc_score, roc_curve,\n    confusion_matrix, ConfusionMatrixDisplay,\n    average_precision_score, f1_score, balanced_accuracy_score,\n    precision_recall_curve,\n)\n\nwarnings.filterwarnings('ignore')\nsns.set_theme(style='whitegrid', palette='colorblind')\nprint('✅ Import selesai')\nprint(f'   TF  : {tf.__version__}')\nprint(f'   GPU : {tf.config.list_physical_devices(\"GPU\")}')\n\n\n# ================================================================\n# CELL 2 — KONFIGURASI\n# ================================================================\n\nBASE_INPUT = '/kaggle/input/datasets/harshwardhanfartale/eyes-defy-anemia/dataset anemia'\nFILE_INDIA = os.path.join(BASE_INPUT, 'India', 'India.xlsx')\nFILE_ITALY = os.path.join(BASE_INPUT, 'Italy', 'Italy.xlsx')\n\n# Root folder tiap negara (berisi subfolder 1/, 2/, 3/, ...)\nFOLDER_INDIA = os.path.join(BASE_INPUT, 'India')\nFOLDER_ITALY = os.path.join(BASE_INPUT, 'Italy')\n\nOUTPUT_DIR = '/kaggle/working/model_anemia'\n\n# Threshold HGB\nHGB_THRESHOLD_FEMALE = 12.0\nHGB_THRESHOLD_MALE   = 13.0\nHGB_THRESHOLD_SINGLE = 12.0  # fallback jika gender tidak dikenali\n\n# Keyword nama file gambar yang mau diambil (lowercase)\n# Ganti '' untuk ambil SEMUA gambar di subfolder\nIMAGE_KEYWORD = 'palpebral'  # hanya file yang mengandung kata ini\n\n# Hyperparameter\nRANDOM_SEED  = 42\nIMG_SIZE     = 224\nBATCH_SIZE   = 16\nTOTAL_EPOCHS = 80\nLR_INITIAL   = 3e-4\nLR_MIN       = 1e-6\nN_TTA        = 8\nTRAIN_RATIO  = 0.70\nVAL_RATIO    = 0.15\nTEST_RATIO   = 0.15\n\nos.makedirs(OUTPUT_DIR, exist_ok=True)\nprint(f'Output : {OUTPUT_DIR}')\n\n\n# ================================================================\n# CELL 3 — SCAN FOLDER: Number → path gambar\n# ================================================================\n#\n#  Struktur folder yang diharapkan:\n#    India/\n#      1/          ← ini adalah \"Number\" = 1\n#        XXX_palpebral_conjunctiva.jpg\n#        XXX_nail.jpg\n#        ...\n#      2/\n#        ...\n#    Italy/\n#      1/\n#        ...\n#\n#  Fungsi ini scan semua subfolder bernomor, cari file gambar\n#  yang cocok dengan IMAGE_KEYWORD, return dict {number: path}.\n# ================================================================\n\ndef scan_folder_by_number(country_folder, keyword=IMAGE_KEYWORD):\n    \"\"\"\n    Scan subfolder bernomor di dalam country_folder.\n    \n    Returns:\n        dict {number (int): full_path_gambar}\n    \"\"\"\n    number_to_path = {}\n    missing_keyword = []\n    \n    if not os.path.exists(country_folder):\n        print(f'  ⚠️  Folder tidak ada: {country_folder}')\n        return number_to_path\n    \n    for item in sorted(os.listdir(country_folder)):\n        subfolder = os.path.join(country_folder, item)\n        \n        # Skip file (hanya proses folder)\n        if not os.path.isdir(subfolder):\n            continue\n        \n        # Coba parse nama folder sebagai angka (Number)\n        try:\n            number = int(item)\n        except ValueError:\n            continue  # bukan subfolder bernomor, skip\n        \n        # Cari gambar di dalam subfolder ini\n        found = None\n        all_imgs = []\n        \n        for fname in sorted(os.listdir(subfolder)):\n            ext = os.path.splitext(fname)[1].lower()\n            if ext not in ('.jpg', '.jpeg', '.png', '.bmp', '.tiff'):\n                continue\n            \n            all_imgs.append(fname)\n            \n            # Kalau keyword kosong, ambil gambar pertama saja\n            if keyword == '':\n                found = os.path.join(subfolder, fname)\n                break\n            \n            # Cari file yang mengandung keyword\n            if keyword.lower() in fname.lower():\n                found = os.path.join(subfolder, fname)\n                break\n        \n        if found:\n            number_to_path[number] = found\n        else:\n            missing_keyword.append((number, all_imgs))\n    \n    print(f'  Subfolder ditemukan: {len(number_to_path)} gambar valid')\n    if missing_keyword[:5]:\n        print(f'  ⚠️  {len(missing_keyword)} subfolder tanpa keyword \"{keyword}\":')\n        for num, imgs in missing_keyword[:3]:\n            print(f'     Number={num}: {imgs[:3]}')\n        if len(missing_keyword) > 3:\n            print(f'     ... dan {len(missing_keyword)-3} lainnya')\n    \n    return number_to_path\n\n\nprint('Scan folder India...')\nmap_india = scan_folder_by_number(FOLDER_INDIA, keyword=IMAGE_KEYWORD)\n\nprint('Scan folder Italy...')\nmap_italy = scan_folder_by_number(FOLDER_ITALY, keyword=IMAGE_KEYWORD)\n\n# Kalau keyword tidak menghasilkan gambar, coba tanpa keyword\nif len(map_india) == 0:\n    print('\\n⚠️  Tidak ada gambar dengan keyword \"palpebral\" di India.')\n    print('   Mencoba ambil semua gambar (keyword=\"\")...')\n    map_india = scan_folder_by_number(FOLDER_INDIA, keyword='')\n\nif len(map_italy) == 0:\n    print('\\n⚠️  Tidak ada gambar dengan keyword \"palpebral\" di Italy.')\n    print('   Mencoba ambil semua gambar (keyword=\"\")...')\n    map_italy = scan_folder_by_number(FOLDER_ITALY, keyword='')\n\nprint(f'\\nTotal peta gambar: India={len(map_india)}, Italy={len(map_italy)}')\n\n# Tampilkan beberapa contoh nama file yang ditemukan\nprint('\\nContoh gambar India (5 pertama):')\nfor num, path in list(map_india.items())[:5]:\n    print(f'  Number={num}: {os.path.basename(path)}')\n\nprint('\\nContoh gambar Italy (5 pertama):')\nfor num, path in list(map_italy.items())[:5]:\n    print(f'  Number={num}: {os.path.basename(path)}')\n\n\n# ================================================================\n# CELL 4 — LOAD EXCEL + LABELING OTOMATIS\n# ================================================================\n\ndef load_and_label_excel(file_path, number_to_path_map, country_name):\n    \"\"\"\n    Baca Excel, bersihkan HGB, buat label otomatis, \n    cocokkan dengan path gambar dari scan folder.\n    \"\"\"\n    df = pd.read_excel(file_path)\n    \n    # Bersihkan kolom unnamed\n    junk = [c for c in df.columns if 'unnamed' in c.lower() or c.lower() in ('note', 'notes')]\n    df   = df.drop(columns=junk, errors='ignore')\n    \n    print(f'\\n[{country_name}] Kolom: {list(df.columns)}')\n    \n    # Normalisasi nama kolom\n    col_map = {c.strip().lower(): c.strip() for c in df.columns}\n    \n    # Cari kolom Number\n    num_col = None\n    for candidate in ('number', 'no', 'no.', 'id', 'sample', 'num'):\n        if candidate in col_map:\n            num_col = col_map[candidate]\n            break\n    if num_col is None:\n        raise ValueError(f\"Kolom 'Number' tidak ditemukan di {country_name}. Kolom: {list(df.columns)}\")\n    \n    # Cari kolom HGB\n    hgb_col = None\n    for candidate in ('hgb', 'hemoglobin', 'hb', 'haemoglobin'):\n        if candidate in col_map:\n            hgb_col = col_map[candidate]\n            break\n    if hgb_col is None:\n        raise ValueError(f\"Kolom 'Hgb' tidak ditemukan di {country_name}. Kolom: {list(df.columns)}\")\n    \n    # Bersihkan HGB (ada yang pakai koma desimal)\n    df['Hgb_clean'] = pd.to_numeric(\n        df[hgb_col].astype(str)\n                   .str.replace(',', '.', regex=False)\n                   .str.strip(),\n        errors='coerce'\n    )\n    \n    # Kolom Gender (opsional)\n    gender_col = None\n    for candidate in ('gender', 'sex', 'jenis kelamin'):\n        if candidate in col_map:\n            gender_col = col_map[candidate]\n            break\n    df['Gender_clean'] = df[gender_col].astype(str).str.strip() if gender_col else 'Unknown'\n    \n    # Drop baris tanpa HGB\n    df = df.dropna(subset=['Hgb_clean']).copy()\n    df[num_col] = pd.to_numeric(df[num_col], errors='coerce')\n    df = df.dropna(subset=[num_col]).copy()\n    df[num_col] = df[num_col].astype(int)\n    \n    # ── LABELING OTOMATIS\n    def assign_label(row):\n        hgb = row['Hgb_clean']\n        g   = row['Gender_clean'].upper()\n        if g in ('F', 'FEMALE', 'PEREMPUAN', 'P', 'W', 'WANITA'):\n            return 'Anemia' if hgb < HGB_THRESHOLD_FEMALE else 'Non-Anemia'\n        elif g in ('M', 'MALE', 'LAKI', 'LAKI-LAKI', 'L', 'PRIA', 'MAN'):\n            return 'Anemia' if hgb < HGB_THRESHOLD_MALE else 'Non-Anemia'\n        else:\n            return 'Anemia' if hgb < HGB_THRESHOLD_SINGLE else 'Non-Anemia'\n    \n    df['label'] = df.apply(assign_label, axis=1)\n    df['y']     = (df['label'] == 'Anemia').astype(int)\n    \n    # ── COCOKKAN dengan path gambar dari scan folder\n    df['full_path'] = df[num_col].map(number_to_path_map)\n    \n    # Statistik\n    total    = len(df)\n    matched  = df['full_path'].notna().sum()\n    missing  = total - matched\n    \n    print(f'  Total sampel      : {total}')\n    print(f'  Gambar ditemukan  : {matched}')\n    print(f'  Gambar tidak ada  : {missing}')\n    print(f'  Anemia            : {(df[\"y\"]==1).sum()} ({(df[\"y\"]==1).mean()*100:.1f}%)')\n    print(f'  Non-Anemia        : {(df[\"y\"]==0).sum()} ({(df[\"y\"]==0).mean()*100:.1f}%)')\n    print(f'  HGB range         : {df[\"Hgb_clean\"].min():.1f} – {df[\"Hgb_clean\"].max():.1f}')\n    \n    if missing > 0:\n        print(f'  ⚠️  Contoh Number tidak cocok: {df[df[\"full_path\"].isna()][num_col].head(5).tolist()}')\n    \n    return df[['full_path', 'Hgb_clean', 'Gender_clean', 'label', 'y']].copy()\n\n\ndfs = []\nif os.path.exists(FILE_INDIA) and len(map_india) > 0:\n    dfs.append(load_and_label_excel(FILE_INDIA, map_india, 'India'))\nif os.path.exists(FILE_ITALY) and len(map_italy) > 0:\n    dfs.append(load_and_label_excel(FILE_ITALY, map_italy, 'Italy'))\n\nif not dfs:\n    raise RuntimeError(\"Tidak ada data yang berhasil dimuat.\")\n\ndf_all   = pd.concat(dfs, ignore_index=True)\ndf_valid = df_all.dropna(subset=['full_path']).reset_index(drop=True)\n\nprint(f'\\nTotal valid (ada gambar + label): {len(df_valid)}')\nprint(f'Distribusi: {df_valid[\"label\"].value_counts().to_dict()}')\n\n\n# ================================================================\n# CELL 5 — SPLIT DATA\n# ================================================================\n\nle = LabelEncoder()\ndf_valid['y_enc'] = le.fit_transform(df_valid['label'])\nANEM_IDX = int(np.where(le.classes_ == 'Anemia')[0][0])\nprint(f'Kelas: {list(le.classes_)} | Anemia index: {ANEM_IDX}')\n\ntrain_val, test_df = train_test_split(\n    df_valid, test_size=TEST_RATIO,\n    random_state=RANDOM_SEED, stratify=df_valid['y_enc']\n)\nval_ratio_rel = VAL_RATIO / (TRAIN_RATIO + VAL_RATIO)\ntrain_df, val_df = train_test_split(\n    train_val, test_size=val_ratio_rel,\n    random_state=RANDOM_SEED, stratify=train_val['y_enc']\n)\n\ntrain_df = train_df.reset_index(drop=True)\nval_df   = val_df.reset_index(drop=True)\ntest_df  = test_df.reset_index(drop=True)\n\nprint(f'\\nTrain : {len(train_df)} | Val: {len(val_df)} | Test: {len(test_df)}')\n\nn_total = len(train_df)\nn_0 = (train_df['y_enc'] == 0).sum()\nn_1 = (train_df['y_enc'] == 1).sum()\nCLASS_WEIGHTS = {0: n_total / (2 * n_0), 1: n_total / (2 * n_1)}\nprint(f'Class weights: {CLASS_WEIGHTS}')\n\n\n# ================================================================\n# CELL 6 — AUGMENTASI\n# ================================================================\n\naug_train = A.Compose([\n    A.HorizontalFlip(p=0.5),\n    A.ShiftScaleRotate(shift_limit=0.05, scale_limit=0.08, rotate_limit=10,\n                       border_mode=cv2.BORDER_REFLECT_101, p=0.6),\n    A.RandomBrightnessContrast(brightness_limit=0.20, contrast_limit=0.20, p=0.7),\n    A.HueSaturationValue(hue_shift_limit=8, sat_shift_limit=20, val_shift_limit=10, p=0.6),\n    A.CLAHE(clip_limit=2.0, tile_grid_size=(8, 8), p=0.4),\n    A.GaussNoise(var_limit=(5.0, 20.0), p=0.25),\n    A.Resize(IMG_SIZE, IMG_SIZE),\n])\n\naug_tta = A.Compose([\n    A.HorizontalFlip(p=0.5),\n    A.ShiftScaleRotate(shift_limit=0.03, scale_limit=0.05, rotate_limit=5,\n                       border_mode=cv2.BORDER_REFLECT_101, p=0.5),\n    A.RandomBrightnessContrast(brightness_limit=0.10, contrast_limit=0.10, p=0.5),\n    A.Resize(IMG_SIZE, IMG_SIZE),\n])\n\naug_eval = A.Compose([\n    A.LongestMaxSize(max_size=IMG_SIZE),\n    A.PadIfNeeded(min_height=IMG_SIZE, min_width=IMG_SIZE,\n                  border_mode=cv2.BORDER_CONSTANT, value=0),\n    A.Resize(IMG_SIZE, IMG_SIZE),\n])\n\n\n# ================================================================\n# CELL 7 — DATA GENERATOR\n# ================================================================\n\ndef load_image(full_path, aug_pipeline):\n    img_bgr = cv2.imread(full_path)\n    if img_bgr is None:\n        return np.zeros((IMG_SIZE, IMG_SIZE, 3), dtype=np.float32)\n    img_rgb = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB)\n    aug_out = aug_pipeline(image=img_rgb)['image']\n    return preprocess_input(aug_out.astype(np.float32))\n\n\ndef mixup_batch(X, y, alpha=0.2):\n    bs  = X.shape[0]\n    lam = np.random.beta(alpha, alpha, bs)\n    idx = np.random.permutation(bs)\n    lx  = lam.reshape(bs, 1, 1, 1).astype(np.float32)\n    ly  = lam.reshape(bs, 1).astype(np.float32)\n    return (lx * X + (1 - lx) * X[idx],\n            (ly * y.reshape(-1, 1) + (1 - ly) * y[idx].reshape(-1, 1)).flatten())\n\n\nclass AnemiaGenerator(keras.utils.Sequence):\n    def __init__(self, df, aug_pipeline, batch_size,\n                 shuffle=True, use_mixup=True, mixup_alpha=0.2):\n        self.df          = df.reset_index(drop=True)\n        self.aug         = aug_pipeline\n        self.batch_size  = batch_size\n        self.shuffle     = shuffle\n        self.use_mixup   = use_mixup\n        self.mixup_alpha = mixup_alpha\n        self.indices     = np.arange(len(self.df))\n        self.on_epoch_end()\n\n    def __len__(self):\n        return math.ceil(len(self.df) / self.batch_size)\n\n    def on_epoch_end(self):\n        if self.shuffle:\n            np.random.shuffle(self.indices)\n\n    def __getitem__(self, idx):\n        batch_idx  = self.indices[idx * self.batch_size:(idx + 1) * self.batch_size]\n        batch_rows = self.df.iloc[batch_idx]\n        X = np.array([load_image(r['full_path'], self.aug)\n                      for _, r in batch_rows.iterrows()], dtype=np.float32)\n        y = batch_rows['y_enc'].values.astype(np.float32)\n        if self.use_mixup and len(X) > 1:\n            X, y = mixup_batch(X, y, alpha=self.mixup_alpha)\n        return X, y\n\n\n# ================================================================\n# CELL 8 — MODEL: EFFICIENTNETB0 (FROZEN BACKBONE + GeM POOLING)\n# ================================================================\n\nclass GeMPooling(layers.Layer):\n    def __init__(self, p=3.0, **kwargs):\n        super().__init__(**kwargs)\n        self.p = tf.Variable(p, trainable=True, dtype=tf.float32, name='gem_p')\n    def call(self, x, training=None):\n        x = tf.clip_by_value(x, 1e-6, tf.reduce_max(x))\n        return tf.pow(tf.reduce_mean(tf.pow(x, self.p), axis=[1, 2]), 1.0 / self.p)\n    def get_config(self):\n        config = super().get_config()\n        config.update({'p': float(self.p.numpy())})\n        return config\n\n\ndef build_model(input_shape=(IMG_SIZE, IMG_SIZE, 3), l2_reg=1e-4):\n    backbone = EfficientNetB0(weights='imagenet', include_top=False,\n                               input_shape=input_shape, pooling=None)\n    backbone.trainable = False\n    print(f'Backbone FROZEN: {backbone.count_params():,} params')\n\n    inputs = keras.Input(shape=input_shape, name='input')\n    x      = backbone(inputs, training=False)\n    x      = GeMPooling(p=3.0, name='gem_pool')(x)\n    x      = layers.LayerNormalization(name='feat_norm')(x)\n\n    for units, drop, name in [(512, 0.5, '512'), (256, 0.4, '256'), (128, 0.3, '128')]:\n        x = layers.Dense(units, kernel_regularizer=regularizers.l2(l2_reg),\n                         name=f'dense_{name}')(x)\n        x = layers.BatchNormalization(name=f'bn_{name}')(x)\n        x = layers.Activation('relu', name=f'relu_{name}')(x)\n        x = layers.Dropout(drop, name=f'do_{name}')(x)\n\n    outputs = layers.Dense(1, activation='sigmoid', name='output')(x)\n    model   = keras.Model(inputs=inputs, outputs=outputs, name='AnemiaNet')\n    model.compile(\n        optimizer=optimizers.AdamW(learning_rate=LR_INITIAL, weight_decay=1e-4),\n        loss=keras.losses.BinaryCrossentropy(label_smoothing=0.1),\n        metrics=['accuracy', keras.metrics.AUC(name='auc'),\n                 keras.metrics.Precision(name='precision'),\n                 keras.metrics.Recall(name='recall')]\n    )\n    head_p = sum(tf.size(w).numpy() for w in model.trainable_weights)\n    print(f'Head (trainable): {head_p:,} params')\n    return model\n\n\ndef cosine_warmup_lr(epoch, total=TOTAL_EPOCHS, lr_max=LR_INITIAL,\n                     lr_min=LR_MIN, warmup=5):\n    if epoch < warmup:\n        return lr_min + (lr_max - lr_min) * (epoch / warmup)\n    progress = (epoch - warmup) / (total - warmup)\n    return lr_min + 0.5 * (lr_max - lr_min) * (1 + math.cos(math.pi * progress))\n\n\ndef get_callbacks(output_dir):\n    return [\n        callbacks.ModelCheckpoint(\n            os.path.join(output_dir, 'best_model.keras'),\n            monitor='val_auc', mode='max', save_best_only=True, verbose=1),\n        callbacks.EarlyStopping(\n            monitor='val_auc', mode='max', patience=20,\n            restore_best_weights=True, min_delta=0.005, verbose=1),\n        callbacks.LearningRateScheduler(cosine_warmup_lr, verbose=0),\n        callbacks.CSVLogger(os.path.join(output_dir, 'log.csv')),\n    ]\n\n\n# ================================================================\n# CELL 9 — TRAINING\n# ================================================================\n\nprint('\\n' + '='*55)\nprint('TRAINING EfficientNetB0 (frozen backbone)')\nprint('='*55)\n\ngen_train = AnemiaGenerator(train_df, aug_train, BATCH_SIZE,\n                             shuffle=True, use_mixup=True)\ngen_val   = AnemiaGenerator(val_df,   aug_eval,  BATCH_SIZE,\n                             shuffle=False, use_mixup=False)\n\nmodel   = build_model()\nt0      = time.time()\nhistory = model.fit(\n    gen_train, validation_data=gen_val,\n    epochs=TOTAL_EPOCHS, class_weight=CLASS_WEIGHTS,\n    callbacks=get_callbacks(OUTPUT_DIR), verbose=1,\n)\nprint(f'Training selesai: {time.time()-t0:.0f}s')\n\nbest_path = os.path.join(OUTPUT_DIR, 'best_model.keras')\nif os.path.exists(best_path):\n    model = keras.models.load_model(best_path,\n                                    custom_objects={'GeMPooling': GeMPooling})\n    print('✅ Best model loaded')\n\nbest_val_auc = max(history.history.get('val_auc', [0]))\nprint(f'Best val AUC: {best_val_auc:.4f}')\n\n\n# ================================================================\n# CELL 10 — PREDIKSI TTA + THRESHOLD TUNING\n# ================================================================\n\ndef predict_tta(model, df, n_tta=N_TTA, batch_size=BATCH_SIZE):\n    all_probas = []\n    for i in range(n_tta):\n        aug  = aug_eval if i == 0 else aug_tta\n        imgs = np.array([load_image(r['full_path'], aug)\n                         for _, r in df.iterrows()], dtype=np.float32)\n        all_probas.append(model.predict(imgs, batch_size=batch_size, verbose=0).flatten())\n    return np.mean(all_probas, axis=0)\n\n\nprint('\\nPrediksi TTA...')\nproba_val  = predict_tta(model, val_df)\nproba_test = predict_tta(model, test_df)\n\ny_val  = val_df['y_enc'].values\ny_test = test_df['y_enc'].values\n\nprint(f'Val  AUC (TTA): {roc_auc_score(y_val,  proba_val):.4f}')\nprint(f'Test AUC (TTA): {roc_auc_score(y_test, proba_test):.4f}')\n\n# Threshold tuning\nthresh_results = [\n    {'threshold': t,\n     'f1': f1_score(y_val, (proba_val >= t).astype(int),\n                    pos_label=ANEM_IDX, zero_division=0)}\n    for t in np.arange(0.10, 0.91, 0.02)\n]\ndf_thresh   = pd.DataFrame(thresh_results)\nbest_row    = df_thresh.loc[df_thresh['f1'].idxmax()]\nbest_thresh = float(best_row['threshold'])\nprint(f'Best threshold: {best_thresh:.2f}  F1={best_row[\"f1\"]:.4f}')\n\n\n# ================================================================\n# CELL 11 — EVALUASI TEST SET\n# ================================================================\n\nprint('\\n' + '='*55)\nprint('EVALUASI TEST SET')\nprint('='*55)\n\nauc_test = roc_auc_score(y_test, proba_test)\nap_test  = average_precision_score(y_test, proba_test)\n\nfor label, thresh in [('0.50', 0.50), (f'{best_thresh:.2f} tuned', best_thresh)]:\n    pred = (proba_test >= thresh).astype(int)\n    bacc = balanced_accuracy_score(y_test, pred)\n    print(f'\\n[Threshold = {label}]')\n    print(f'AUC={auc_test:.4f} | AP={ap_test:.4f} | BalAcc={bacc:.4f}')\n    print(classification_report(y_test, pred, target_names=le.classes_))\n\n\n# ================================================================\n# CELL 12 — VISUALISASI\n# ================================================================\n\nep_range = list(range(1, len(history.history['loss']) + 1))\nep_lr    = list(range(TOTAL_EPOCHS))\nlrs      = [cosine_warmup_lr(e) for e in ep_lr]\n\nfig, axes = plt.subplots(2, 3, figsize=(20, 12))\n\naxes[0,0].plot(ep_range, history.history['loss'], label='Train', lw=2)\naxes[0,0].plot(ep_range, history.history['val_loss'], label='Val', lw=2, ls='--')\naxes[0,0].set_title('Loss'); axes[0,0].legend(); axes[0,0].grid(alpha=0.3)\n\naxes[0,1].plot(ep_range, history.history['auc'], label='Train AUC', lw=2)\naxes[0,1].plot(ep_range, history.history['val_auc'], label='Val AUC', lw=2, ls='--')\naxes[0,1].axhline(best_val_auc, color='green', ls=':', alpha=0.8, label=f'Best={best_val_auc:.3f}')\naxes[0,1].set_title('AUC'); axes[0,1].legend(); axes[0,1].grid(alpha=0.3)\n\naxes[0,2].plot(ep_lr, lrs, color='purple', lw=2)\naxes[0,2].set_title('LR Schedule'); axes[0,2].set_yscale('log'); axes[0,2].grid(alpha=0.3)\n\nfpr, tpr, _ = roc_curve(y_test, proba_test)\naxes[1,0].plot(fpr, tpr, lw=2.5, color='#e74c3c', label=f'AUC={auc_test:.4f}')\naxes[1,0].plot([0,1],[0,1],'k--',alpha=0.4)\naxes[1,0].set_title('ROC Curve (Test)'); axes[1,0].legend(); axes[1,0].grid(alpha=0.3)\n\nprec, rec, _ = precision_recall_curve(y_test, proba_test)\naxes[1,1].plot(rec, prec, lw=2.5, color='#3498db', label=f'AP={ap_test:.4f}')\naxes[1,1].set_title('Precision-Recall'); axes[1,1].legend(); axes[1,1].grid(alpha=0.3)\n\npred_tuned = (proba_test >= best_thresh).astype(int)\ndisp = ConfusionMatrixDisplay(confusion_matrix(y_test, pred_tuned),\n                               display_labels=le.classes_)\ndisp.plot(ax=axes[1,2], colorbar=False)\naxes[1,2].set_title(f'Confusion Matrix (thr={best_thresh:.2f})')\n\nplt.suptitle(f'Anemia Detection EfficientNetB0\\nTest AUC={auc_test:.4f} | Threshold={best_thresh:.2f}',\n             fontsize=12)\nplt.tight_layout()\nplt.savefig(os.path.join(OUTPUT_DIR, 'evaluation.png'), dpi=150, bbox_inches='tight')\nplt.show()\n\n\n# ================================================================\n# CELL 13 — SIMPAN MODEL\n# ================================================================\n\nmodel.save(os.path.join(OUTPUT_DIR, 'anemia_model_final.keras'))\njoblib.dump(le, os.path.join(OUTPUT_DIR, 'label_encoder.pkl'))\nconfig_saved = {\n    'img_size': IMG_SIZE, 'best_thresh': best_thresh, 'n_tta': N_TTA,\n    'anemia_idx': ANEM_IDX, 'classes': list(le.classes_),\n    'test_auc': float(auc_test), 'test_ap': float(ap_test),\n    'image_keyword': IMAGE_KEYWORD,\n}\njoblib.dump(config_saved, os.path.join(OUTPUT_DIR, 'config.pkl'))\nprint(f'✅ Model tersimpan: {OUTPUT_DIR}')\n\n\n# ================================================================\n# CELL 14 — FUNGSI INFERENCE\n# ================================================================\n\ndef prediksi_anemia(image_path, model, config_dict):\n    \"\"\"\n    Prediksi anemia dari satu gambar palpebral.\n    Input: path gambar (jpg/png)\n    Output: dict prediksi\n    \"\"\"\n    thresh   = config_dict['best_thresh']\n    n_tta_i  = config_dict['n_tta']\n    img_bgr  = cv2.imread(image_path)\n    if img_bgr is None:\n        return {'error': f'Gambar tidak bisa dibaca: {image_path}'}\n    img_rgb = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB)\n    probas  = []\n    for i in range(n_tta_i):\n        aug     = aug_eval if i == 0 else aug_tta\n        aug_img = aug(image=img_rgb)['image']\n        arr     = preprocess_input(aug_img.astype(np.float32))\n        probas.append(float(model.predict(arr[np.newaxis], verbose=0)[0, 0]))\n    proba     = float(np.mean(probas))\n    is_anemia = proba >= thresh\n    return {\n        'prediksi'    : 'Anemia' if is_anemia else 'Non-Anemia',\n        'probabilitas': round(proba, 4),\n        'confidence'  : round(proba if is_anemia else 1 - proba, 4),\n        'threshold'   : round(thresh, 2),\n        'keterangan'  : ('⚠️  Kemungkinan anemia — konsultasi dokter.'\n                         if is_anemia else '✅ Tidak terindikasi anemia.'),\n    }\n\n\n# Contoh prediksi pada test set\nsample_path = test_df['full_path'].iloc[0]\nif os.path.exists(sample_path):\n    hasil = prediksi_anemia(sample_path, model, config_saved)\n    print('\\nContoh prediksi:')\n    for k, v in hasil.items():\n        print(f'  {k:15s}: {v}')\n    print(f'  {\"label asli\":15s}: {test_df[\"label\"].iloc[0]}')\n\nprint('\\n' + '='*55)\nprint('✅ SELESAI')\nprint('='*55)","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-05-28T11:10:55.825950Z","iopub.execute_input":"2026-05-28T11:10:55.826903Z","iopub.status.idle":"2026-05-28T11:22:03.292210Z","shell.execute_reply.started":"2026-05-28T11:10:55.826860Z","shell.execute_reply":"2026-05-28T11:22:03.291536Z"}},"outputs":[],"execution_count":null}]}