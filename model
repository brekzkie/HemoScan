    "    print(f'  Non-Anemia        : {(df[\"y\"]==0).sum()} ({(df[\"y\"]==0).mean()*100:.1f}%)')\n",
    "\n",
    "    return df[['full_path', 'Hgb_clean', 'Gender_clean', 'label', 'y']].copy()\n",
    "\n",
    "\n",
    "dfs = []\n",
