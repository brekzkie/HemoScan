    "aug_tta = A.Compose([\n",
    "    A.HorizontalFlip(p=0.5),\n",
    "    A.ShiftScaleRotate(shift_limit=0.03, scale_limit=0.05, rotate_limit=5,\n",
    "                       border_mode=cv2.BORDER_REFLECT_101, p=0.5),\n",
    "    A.RandomBrightnessContrast(brightness_limit=0.10, contrast_limit=0.10, p=0.5),\n",
    "    A.Resize(IMG_SIZE, IMG_SIZE),\n",
    "])\n",
    "\n",
    "aug_eval = A.Compose([\n",
    "    A.LongestMaxSize(max_size=IMG_SIZE),\n",
    "    A.PadIfNeeded(min_height=IMG_SIZE, min_width=IMG_SIZE,\n",
    "                  border_mode=cv2.BORDER_CONSTANT, value=0),\n",
    "    A.Resize(IMG_SIZE, IMG_SIZE),\n",
    "])\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# CELL 7 — DATA GENERATOR (tidak berubah dari V2)\n",
    "# ================================================================\n",
    "\n",
    "def load_image(full_path, aug_pipeline):\n",
    "    img_bgr = cv2.imread(full_path)\n",
    "    if img_bgr is None:\n",
    "        return np.zeros((IMG_SIZE, IMG_SIZE, 3), dtype=np.float32)\n",
    "    img_rgb = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB)\n",
    "    aug_out = aug_pipeline(image=img_rgb)['image']\n",
    "    return preprocess_input(aug_out.astype(np.float32))\n",
    "\n",
    "\n",
    "def mixup_batch(X, y, alpha=0.3):                                # ✨ alpha 0.2 → 0.3\n",
    "    bs  = X.shape[0]\n",
    "    lam = np.random.beta(alpha, alpha, bs)\n",
    "    idx = np.random.permutation(bs)\n",
    "    lx  = lam.reshape(bs, 1, 1, 1).astype(np.float32)\n",
    "    ly  = lam.reshape(bs, 1).astype(np.float32)\n",
    "    return (lx * X + (1 - lx) * X[idx],\n",
    "            (ly * y.reshape(-1, 1) + (1 - ly) * y[idx].reshape(-1, 1)).flatten())\n",
    "\n",
    "\n",
    "class AnemiaGenerator(keras.utils.Sequence):\n",
    "    def __init__(self, df, aug_pipeline, batch_size,\n",
    "                 shuffle=True, use_mixup=True, mixup_alpha=0.3):  # ✨ alpha naik\n",
    "        self.df          = df.reset_index(drop=True)\n",
    "        self.aug         = aug_pipeline\n",
    "        self.batch_size  = batch_size\n",
    "        self.shuffle     = shuffle\n",
    "        self.use_mixup   = use_mixup\n",
    "        self.mixup_alpha = mixup_alpha\n",
    "        self.indices     = np.arange(len(self.df))\n",
    "        self.on_epoch_end()\n",
    "\n",
    "    def __len__(self):\n",
    "        return math.ceil(len(self.df) / self.batch_size)\n",
    "\n",
    "    def on_epoch_end(self):\n",
    "        if self.shuffle:\n",
    "            np.random.shuffle(self.indices)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        batch_idx  = self.indices[idx * self.batch_size:(idx + 1) * self.batch_size]\n",
    "        batch_rows = self.df.iloc[batch_idx]\n",
    "        X = np.array([load_image(r['full_path'], self.aug)\n",
    "                      for _, r in batch_rows.iterrows()], dtype=np.float32)\n",
    "        y = batch_rows['y_enc'].values.astype(np.float32)\n",
    "        if self.use_mixup and len(X) > 1:\n",
    "            X, y = mixup_batch(X, y, alpha=self.mixup_alpha)\n",
    "        return X, y\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# CELL 8 — ✨ FOCAL LOSS (baru, solusi utama untuk imbalanced)\n",
    "# ================================================================\n",
    "\n",
    "class BinaryFocalLoss(keras.losses.Loss):\n",
    "    \"\"\"\n",
    "    Focal Loss untuk binary classification.\n",
    "    Down-weight contoh mudah, fokus ke contoh sulit.\n",
    "    - alpha : bobot kelas positif (Anemia). Naikkan jika recall kurang.\n",
    "    - gamma : focusing parameter. Semakin besar = semakin fokus ke hard examples.\n",
    "    \"\"\"\n",
    "    def __init__(self, alpha=0.25, gamma=2.0, **kwargs):\n",
    "        super().__init__(**kwargs)\n",
    "        self.alpha = alpha\n",
    "        self.gamma = gamma\n",
    "\n",
    "    def call(self, y_true, y_pred):\n",
    "        y_pred  = tf.clip_by_value(y_pred, 1e-7, 1 - 1e-7)\n",
    "        bce     = -y_true * tf.math.log(y_pred) - (1 - y_true) * tf.math.log(1 - y_pred)\n",
    "        p_t     = y_true * y_pred + (1 - y_true) * (1 - y_pred)\n",
    "        alpha_t = y_true * self.alpha + (1 - y_true) * (1 - self.alpha)\n",
    "        focal_w = alpha_t * tf.pow(1.0 - p_t, self.gamma)\n",
    "        return tf.reduce_mean(focal_w * bce)\n",
    "\n",
    "    def get_config(self):\n",
    "        cfg = super().get_config()\n",
    "        cfg.update({'alpha': self.alpha, 'gamma': self.gamma})\n",
    "        return cfg\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# CELL 9 — ✨ MODEL: EFFICIENTNETB2 + GeMPooling\n",
    "# ================================================================\n",
    "\n",
    "class GeMPooling(layers.Layer):\n",
    "    def __init__(self, p=3.0, **kwargs):\n",
    "        super().__init__(**kwargs)\n",
    "        self.p = tf.Variable(p, trainable=True, dtype=tf.float32, name='gem_p')\n",
    "\n",
    "    def call(self, x, training=None):\n",
    "        x = tf.clip_by_value(x, 1e-6, tf.reduce_max(x))\n",
    "        return tf.pow(tf.reduce_mean(tf.pow(x, self.p), axis=[1, 2]), 1.0 / self.p)\n",
    "\n",
    "    def get_config(self):\n",
    "        config = super().get_config()\n",
    "        config.update({'p': float(self.p.numpy())})\n",
    "        return config\n",
    "\n",
    "\n",
    "def build_model(input_shape=(IMG_SIZE, IMG_SIZE, 3), l2_reg=1e-4, freeze_backbone=True):\n",
    "    # ✨ EfficientNetB2 menggantikan B0\n",
    "    backbone = EfficientNetB2(\n",
    "        weights='imagenet', include_top=False,\n",
    "        input_shape=input_shape, pooling=None\n",
    "    )\n",
    "    backbone.trainable = not freeze_backbone\n",
    "    status = 'FROZEN' if freeze_backbone else 'TRAINABLE'\n",
    "    print(f'Backbone {status}: {backbone.count_params():,} params')\n",
    "\n",
    "    inputs = keras.Input(shape=input_shape, name='input')\n",
    "    x      = backbone(inputs, training=freeze_backbone is False)\n",
    "    x      = GeMPooling(p=3.0, name='gem_pool')(x)\n",
    "    x      = layers.LayerNormalization(name='feat_norm')(x)\n",
    "\n",
    "    for units, drop, name in [(512, 0.5, '512'), (256, 0.4, '256'), (128, 0.3, '128')]:\n",
    "        x = layers.Dense(units, kernel_regularizer=regularizers.l2(l2_reg),\n",
    "                         name=f'dense_{name}')(x)\n",
    "        x = layers.BatchNormalization(name=f'bn_{name}')(x)\n",
    "        x = layers.Activation('relu', name=f'relu_{name}')(x)\n",
    "        x = layers.Dropout(drop, name=f'do_{name}')(x)\n",
    "\n",
    "    outputs = layers.Dense(1, activation='sigmoid', name='output')(x)\n",
    "    model   = keras.Model(inputs=inputs, outputs=outputs, name='AnemiaNet_v3')\n",
    "    return model\n",
    "\n",
    "\n",
    "def compile_model(model, lr, focal_alpha=0.25, focal_gamma=2.0):\n",
    "    \"\"\"✨ Compile dengan Focal Loss + PR-AUC metric tambahan\"\"\"\n",
    "    model.compile(\n",
    "        optimizer=optimizers.AdamW(learning_rate=lr, weight_decay=1e-4),\n",
    "        loss=BinaryFocalLoss(alpha=focal_alpha, gamma=focal_gamma),  # ✨ Focal Loss\n",
    "        metrics=[\n",
    "            'accuracy',\n",
    "            keras.metrics.AUC(name='auc'),\n",
    "            keras.metrics.AUC(name='auc_pr', curve='PR'),            # ✨ PR-AUC baru\n",
    "            keras.metrics.Precision(name='precision'),\n",
    "            keras.metrics.Recall(name='recall'),\n",
    "        ]\n",
    "    )\n",
    "    head_p = sum(tf.size(w).numpy() for w in model.trainable_weights)\n",
    "    print(f'Trainable params: {head_p:,}')\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# CELL 10 — LR SCHEDULE + CALLBACKS\n",
    "# ================================================================\n",
    "\n",
    "def cosine_warmup_lr(epoch, total, lr_max, lr_min=LR_MIN, warmup=5):\n",
    "    if epoch < warmup:\n",
    "        return lr_min + (lr_max - lr_min) * (epoch / warmup)\n",
    "    progress = (epoch - warmup) / (total - warmup)\n",
    "    return lr_min + 0.5 * (lr_max - lr_min) * (1 + math.cos(math.pi * progress))\n",
    "\n",
    "\n",
    "def get_callbacks(output_dir, phase='head', total_epochs=EPOCHS_HEAD, lr_max=LR_HEAD):\n",
    "    return [\n",
    "        callbacks.ModelCheckpoint(\n",
    "            os.path.join(output_dir, f'best_{phase}.keras'),\n",
    "            monitor='val_auc', mode='max', save_best_only=True, verbose=1),\n",
    "        callbacks.EarlyStopping(\n",
    "            monitor='val_auc', mode='max',\n",
    "            patience=15 if phase == 'head' else 20,\n",
    "            restore_best_weights=True, min_delta=0.003, verbose=1),\n",
    "        callbacks.LearningRateScheduler(\n",
    "            lambda ep: cosine_warmup_lr(ep, total_epochs, lr_max), verbose=0),\n",
    "        callbacks.CSVLogger(os.path.join(output_dir, f'log_{phase}.csv')),\n",
    "    ]\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# CELL 11 — ✨ 2-PHASE TRAINING\n",
    "# ================================================================\n",
    "\n",
    "gen_train = AnemiaGenerator(train_df, aug_train, BATCH_SIZE, shuffle=True, use_mixup=True)\n",
    "gen_val   = AnemiaGenerator(val_df,   aug_eval,  BATCH_SIZE, shuffle=False, use_mixup=False)\n",
    "\n",
    "# ── FASE 1: Latih head (backbone frozen) ────────────────────\n",
    "print('\\n' + '='*60)\n",
    "print('FASE 1 — Training HEAD (EfficientNetB2 frozen)')\n",
    "print('='*60)\n",
    "\n",
    "model = build_model(freeze_backbone=True)\n",
    "compile_model(model, lr=LR_HEAD)\n",
    "\n",
    "t0      = time.time()\n",
    "history1 = model.fit(\n",
    "    gen_train, validation_data=gen_val,\n",
    "    epochs=EPOCHS_HEAD,\n",
    "    class_weight=CLASS_WEIGHTS,\n",
    "    callbacks=get_callbacks(OUTPUT_DIR, phase='head',\n",
    "                            total_epochs=EPOCHS_HEAD, lr_max=LR_HEAD),\n",
    "    verbose=1,\n",
    ")\n",
    "print(f'Fase 1 selesai: {time.time()-t0:.0f}s')\n",
    "\n",
    "# Load best dari fase 1\n",
    "best_head_path = os.path.join(OUTPUT_DIR, 'best_head.keras')\n",
    "if os.path.exists(best_head_path):\n",
    "    model = keras.models.load_model(\n",
    "        best_head_path,\n",
    "        custom_objects={'GeMPooling': GeMPooling, 'BinaryFocalLoss': BinaryFocalLoss}\n",
    "    )\n",
    "    print('✅ Best head model loaded')\n",
    "\n",
    "best_val_auc_1 = max(history1.history.get('val_auc', [0]))\n",
    "print(f'Fase 1 best val AUC: {best_val_auc_1:.4f}')\n",
    "\n",
    "# ── FASE 2: Fine-tune top layers backbone ────────────────────\n",
    "print('\\n' + '='*60)\n",
    "print(f'FASE 2 — Fine-tuning (top {UNFREEZE_LAYERS} layers unfrozen)')\n",
    "print('='*60)\n",
    "\n",
    "backbone_layer = model.get_layer('efficientnetb2')\n",
    "backbone_layer.trainable = True\n",
    "\n",
    "# ✨ Freeze semua kecuali N layer terakhir backbone\n",
    "for layer in backbone_layer.layers[:-UNFREEZE_LAYERS]:\n",
    "    layer.trainable = False\n",
    "\n",
    "# Re-compile dengan LR jauh lebih kecil\n",
    "compile_model(model, lr=LR_FINE)\n",
    "\n",
    "t0       = time.time()\n",
    "history2 = model.fit(\n",
    "    gen_train, validation_data=gen_val,\n",
    "    epochs=EPOCHS_FINE,\n",
    "    class_weight=CLASS_WEIGHTS,\n",
    "    callbacks=get_callbacks(OUTPUT_DIR, phase='fine',\n",
    "                            total_epochs=EPOCHS_FINE, lr_max=LR_FINE),\n",
    "    verbose=1,\n",
    ")\n",
    "print(f'Fase 2 selesai: {time.time()-t0:.0f}s')\n",
    "\n",
    "# Load best final\n",
    "best_fine_path = os.path.join(OUTPUT_DIR, 'best_fine.keras')\n",
    "if os.path.exists(best_fine_path):\n",
    "    model = keras.models.load_model(\n",
    "        best_fine_path,\n",
    "        custom_objects={'GeMPooling': GeMPooling, 'BinaryFocalLoss': BinaryFocalLoss}\n",
    "    )\n",
    "    print('✅ Best fine-tuned model loaded')\n",
    "\n",
    "best_val_auc_2 = max(history2.history.get('val_auc', [0]))\n",
    "print(f'Fase 2 best val AUC: {best_val_auc_2:.4f}')\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# CELL 12 — PREDIKSI TTA + THRESHOLD TUNING (tidak berubah)\n",
    "# ================================================================\n",
    "\n",
    "def predict_tta(model, df, n_tta=N_TTA, batch_size=BATCH_SIZE):\n",
    "    all_probas = []\n",
    "    for i in range(n_tta):\n",
    "        aug  = aug_eval if i == 0 else aug_tta\n",
    "        imgs = np.array([load_image(r['full_path'], aug)\n",
    "                         for _, r in df.iterrows()], dtype=np.float32)\n",
    "        all_probas.append(model.predict(imgs, batch_size=batch_size, verbose=0).flatten())\n",
    "    return np.mean(all_probas, axis=0)\n",
    "\n",
    "\n",
    "print('\\nPrediksi TTA...')\n",
    "proba_val  = predict_tta(model, val_df)\n",
    "proba_test = predict_tta(model, test_df)\n",
    "\n",
    "y_val  = val_df['y_enc'].values\n",
    "y_test = test_df['y_enc'].values\n",
    "\n",
    "print(f'Val  AUC (TTA): {roc_auc_score(y_val,  proba_val):.4f}')\n",
    "print(f'Test AUC (TTA): {roc_auc_score(y_test, proba_test):.4f}')\n",
    "\n",
    "thresh_results = [\n",
    "    {'threshold': t,\n",
    "     'f1': f1_score(y_val, (proba_val >= t).astype(int),\n",
    "                    pos_label=ANEM_IDX, zero_division=0)}\n",
    "    for t in np.arange(0.10, 0.91, 0.02)\n",
    "]\n",
    "df_thresh   = pd.DataFrame(thresh_results)\n",
    "best_row    = df_thresh.loc[df_thresh['f1'].idxmax()]\n",
    "best_thresh = float(best_row['threshold'])\n",
    "print(f'Best threshold: {best_thresh:.2f}  F1={best_row[\"f1\"]:.4f}')\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# CELL 13 — EVALUASI TEST SET\n",
    "# ================================================================\n",
    "\n",
    "print('\\n' + '='*60)\n",
    "print('EVALUASI TEST SET')\n",
    "print('='*60)\n",
    "\n",
    "auc_test = roc_auc_score(y_test, proba_test)\n",
    "ap_test  = average_precision_score(y_test, proba_test)\n",
    "\n",
    "for label, thresh in [('0.50', 0.50), (f'{best_thresh:.2f} tuned', best_thresh)]:\n",
    "    pred = (proba_test >= thresh).astype(int)\n",
    "    bacc = balanced_accuracy_score(y_test, pred)\n",
    "    print(f'\\n[Threshold = {label}]')\n",
    "    print(f'AUC={auc_test:.4f} | AP={ap_test:.4f} | BalAcc={bacc:.4f}')\n",
    "    print(classification_report(y_test, pred, target_names=le.classes_))\n",
    "\n",
    "\n",
    "# ================================================================\n",
    "# CELL 14 — ✨ VISUALISASI (tambah plot fase 1 vs fase 2)\n",
    "# ================================================================\n",
    "\n",
    "# Gabungkan history dua fase\n",
    "def merge_history(h1, h2):\n",
    "    merged = {}\n",
    "    for k in h1.history:\n",
    "        merged[k] = h1.history[k] + h2.history.get(k, [])\n",
    "    return merged\n",
    "\n",
    "hist_merged = merge_history(history1, history2)\n",
    "ep_range    = list(range(1, len(hist_merged['loss']) + 1))\n",
    "ep_split    = len(history1.history['loss'])  # titik pemisah fase 1 / fase 2\n",
    "\n",
    "fig, axes = plt.subplots(2, 3, figsize=(20, 12))\n",
    "\n",
    "# Loss\n",
    "axes[0,0].plot(ep_range, hist_merged['loss'],     label='Train', lw=2)\n",
    "axes[0,0].plot(ep_range, hist_merged['val_loss'], label='Val',   lw=2, ls='--')\n",
    "axes[0,0].axvline(ep_split, color='orange', ls=':', alpha=0.8, label='Fine-tune start')\n",
    "axes[0,0].set_title('Focal Loss'); axes[0,0].legend(); axes[0,0].grid(alpha=0.3)\n",
    "\n",
    "# AUC\n",
    "best_auc_final = max(hist_merged['val_auc'])\n",
    "axes[0,1].plot(ep_range, hist_merged['auc'],     label='Train AUC', lw=2)\n",
    "axes[0,1].plot(ep_range, hist_merged['val_auc'], label='Val AUC',   lw=2, ls='--')\n",
    "axes[0,1].axvline(ep_split, color='orange', ls=':', alpha=0.8, label='Fine-tune start')\n",
    "axes[0,1].axhline(best_auc_final, color='green', ls=':', alpha=0.8,\n",
    "                   label=f'Best={best_auc_final:.3f}')\n",
    "axes[0,1].set_title('AUC (ROC)'); axes[0,1].legend(); axes[0,1].grid(alpha=0.3)\n",
    "\n",
    "# PR-AUC ✨\n",
    "axes[0,2].plot(ep_range, hist_merged['auc_pr'],     label='Train PR-AUC', lw=2)\n",
    "axes[0,2].plot(ep_range, hist_merged['val_auc_pr'], label='Val PR-AUC',   lw=2, ls='--')\n",
    "axes[0,2].axvline(ep_split, color='orange', ls=':', alpha=0.8)\n",
    "axes[0,2].set_title('PR-AUC (lebih informatif untuk imbalanced)')\n",
    "axes[0,2].legend(); axes[0,2].grid(alpha=0.3)\n",
    "\n",
    "# ROC Curve\n",
    "fpr, tpr, _ = roc_curve(y_test, proba_test)\n",
    "axes[1,0].plot(fpr, tpr, lw=2.5, color='#e74c3c', label=f'AUC={auc_test:.4f}')\n",
    "axes[1,0].plot([0,1],[0,1],'k--',alpha=0.4)\n",
    "axes[1,0].set_title('ROC Curve (Test)'); axes[1,0].legend(); axes[1,0].grid(alpha=0.3)\n",
    "\n",
    "# Precision-Recall\n",
    "prec, rec, _ = precision_recall_curve(y_test, proba_test)\n",
    "axes[1,1].plot(rec, prec, lw=2.5, color='#3498db', label=f'AP={ap_test:.4f}')\n",
    "axes[1,1].set_title('Precision-Recall'); axes[1,1].legend(); axes[1,1].grid(alpha=0.3)\n",
    "\n",
    "# Confusion Matrix\n",
    "pred_tuned = (proba_test >= best_thresh).astype(int)\n",
    "disp = ConfusionMatrixDisplay(confusion_matrix(y_test, pred_tuned),\n",
    "                               display_labels=le.classes_)\n",
    "disp.plot(ax=axes[1,2], colorbar=False)\n",
    "axes[1,2].set_title(f'Confusion Matrix (thr={best_thresh:.2f})')\n",
    "\n",
    "plt.suptitle(\n",
    "    f'AnemiaNet V3 — EfficientNetB2 + GeMPooling + Focal Loss\\n'\n",
    "    f'Test AUC={auc_test:.4f} | AP={ap_test:.4f} | Threshold={best_thresh:.2f}',\n",
    "    fontsize=12\n",
    ")\n",
    "plt.tight_layout()\n",
    "plt.savefig(os.path.join(OUTPUT_DIR, 'evaluation_v3.png'), dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
