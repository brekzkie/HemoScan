'\\n[Offline Generation]')\n    print(f'  Mayoritas : {maj_label} ({counts.get(1 - min_y_enc, 0)})')\n    print(f'  Minoritas : {min_label} ({counts.get(min_y_enc, 0)})')\n    print(f'  Multiplier: {multiplier}×')\n\n    df_min      = df_src[df_src['y_enc'] == min_y_enc].reset_index(drop=True)\n    rows        = []\n    n_generated = 0\n\n    for _, row in df_min.iterrows():\n        img_bgr = cv2.imread(row['full_path'])\n        if img_bgr is None:\n            continue\n        img_rgb = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB)\n        for _ in range(multiplier):\n            out   = aug_synth(image=img_rgb)['image']\n            fname = f'synth_{min_label}_{n_generated:05d}.jpg'\n            path  = os.path.join(synth_dir, fname)\n            cv2.imwrite(path, cv2.cvtColor(out, cv2.COLOR_RGB2BGR),\n                        [cv2.IMWRITE_JPEG_QUALITY, 95])\n            rows.append({\n                'full_path': path,\n                'label'    : min_label,\n                'y'        : min_y,\n                'y_enc'    : min_y_enc,\n            })\n            n_generated += 1\n\n    print(f'  ✅ {n_generated} gambar sintetis dibuat')\n    return pd.DataFrame(rows)\n\n\ndef image_smote(df_src, synth_dir, n_samples,\n                min_label='Anemia', min_y=1, min_y_enc=1):\n    df_min = df_src[df_src['y_enc'] == min_y_enc].reset_index(drop=True)\n\n    if len(df_min) < 2:\n        print('  ⚠️  Kelas minoritas < 2 sampel, SMOTE dilewati.')\n        return pd.DataFrame()\n\n    print(f'\\n[Image SMOTE] {n_samples} gambar → kelas {min_label}')\n    rows        = []\n    n_generated = 0\n\n    for i in range(n_samples):\n        a, b  = np.random.choice(len(df_min), 2, replace=False)\n        row_a = df_min.iloc[a]\n        row_b = df_min.iloc[b]\n        img_a = cv2.imread(row_a['full_path'])\n        img_b = cv2.imread(row_b['full_path'])\n        if img_a is None or img_b is None:\n            continue\n        img_a = cv2.resize(img_a, (IMG_SIZE, IMG_SIZE))\n  